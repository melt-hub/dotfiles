/* ====================| MELT's ROFI CONFIG (spacemacs-dark) |==================== */

* {
    background: #292b2e;
    foreground: #b2b2b2;
    selection:  #444155;
    comment:    #5e5079;
    red:        #f2241f;
    green:      #67b11d;
    yellow:     #b1951d;
    cyan:       #4f97d7;
    accent:     #4f97d7;

    background-color: @background;
    text-color: @foreground;
}

#window {
    background-color: @background;
    border: 1px;
    border-color: @selection;
    border-radius: 0px;
    width: 600px;
}

#mainbox {
    padding: 12px;
}

#inputbar {
    background-color: @selection;
    text-color: @foreground;
    padding: 8px 12px;
    border: 1px;
    border-color: @accent;
}

#prompt {
    text-color: @accent;
    font-weight: bold;
}

#entry {
    background-color: transparent;
    text-color: @foreground;
}

#listview {
    background-color: transparent;
    margin: 8px 0 0 0;
    lines: 8;
    columns: 1;
}

#element {
    padding: 6px 10px;
    text-color: @foreground;
}

#element.selected.normal {
    background-color: @selection;
    text-color: @accent;
}

#element.selected.active {
    background-color: @selection;
    text-color: @accent;
}

#element.urgent {
    text-color: @red;
}

#element.active {
    text-color: @accent;
}