[global]
; --- Display and Positioning ---
monitor = 0
follow = mouse
width = 300
height = (0, 300)
origin = bottom-center
offset = (10, 50)
scale = 0
notification_limit = 20

; --- Progress Bar ---
progress_bar = true
progress_bar_height = 10
progress_bar_frame_width = 1
highlight = "#50a5a4"
progress_bar_min_width = 150
progress_bar_max_width = 300
progress_bar_corner_radius = 0

; --- General Styling ---
transparency = 10
separator_height = 1
padding = 12
horizontal_padding = 14
text_icon_padding = 10
frame_width = 1
frame_color = "#50a5a4"
gap_size = 5
separator_color = "#50a5a4"
font = Monospace 10
line_height = 0

; --- Text Formatting ---
markup = full
format = "[ %s ]\n%b"
alignment = center
vertical_alignment = center
show_age_threshold = 60
ellipsize = middle
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false

; --- Icons (Fixed) ---
icon_position = left
min_icon_size = 32
max_icon_size = 64
icon_theme = "Papirus-Dark"
enable_recursive_icon_lookup = true
; Percorsi corretti per Fedora dopo l'installazione del pacchetto
icon_path = /usr/share/icons/Papirus-Dark/32x32/status/:/usr/share/icons/Papirus-Dark/32x32/devices/:/usr/share/icons/Papirus-Dark/32x32/apps/

; --- History and Interaction ---
sticky_history = yes
history_length = 20
browser = /usr/bin/xdg-open
always_run_script = true
title = Dunst
class = Dunst
corner_radius = 0
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[experimental]
per_monitor_dpi = false

[urgency_low]
background = "#192330"
foreground = "#6b7a8c"
timeout = 3

[urgency_normal]
background = "#192330"
foreground = "#cdcecf"
timeout = 5

[urgency_critical]
background = "#192330"
foreground = "#cdcecf"
frame_color = "#c94f6d"
timeout = 0