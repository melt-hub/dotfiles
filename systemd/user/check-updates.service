[Unit]
Description=Check for both system and firmware updates and write the amount to tmp

[Service]
Type=oneshot
ExecStart=/bin/bash -c "/home/melt/.local/bin/check_system_updates.sh > /tmp/available_system_updates"
ExecStart=/bin/bash -c "/home/melt/.local/bin/check_firmware_updates.sh > /tmp/available_firmware_updates"