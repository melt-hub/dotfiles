\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{melt-setup}[2026/07/06 Melt Custom Math and TikZ Setup]

% Load main packages
\RequirePackage{clrscode3e}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{forest}
\RequirePackage{authblk}
\RequirePackage{etoolbox}

% Pull in handy TikZ modules
\usetikzlibrary{
  positioning,
  calc,
  arrows.meta,
  shapes.multipart,
  automata,
  matrix,
  intersections
}

% Keep pgfplots up to date
\usepgfplotslibrary{fillbetween, statistics}
\pgfplotsset{compat=newest}

% Kill the ugly red boxes around links
\usepackage{hyperref}
\hypersetup{hidelinks}

% Bump up math sizes so equations pop out a bit more
\DeclareMathSizes{10}{11.5}{8}{6}
\DeclareMathSizes{11}{12.5}{9}{7}

% Make codebox fonts slightly larger for readability
\BeforeBeginEnvironment{codebox}{\fontsize{10.5pt}{13pt}\selectfont}

% Load tcolorbox
\RequirePackage{tcolorbox}
\tcbuselibrary{breakable}