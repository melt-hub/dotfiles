  {
    "layer": "top",
    "position": "top",
    "height": 28,
    "fixed-center": true,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "custom/power-profile",
        "battery",
        "bluetooth",
        "network",
        "custom/firmware-updates",
        "custom/system-updates",        
        "mpd"
    ],
    "modules-center": [
        "sway/window",
    ],
    "modules-right": [
        "disk#home",
        "cpu",
        "memory",
        "temperature",
        "pulseaudio",
        "clock"
    ],

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>",
        "tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "tooltip": false,
        "format-icons": {
            "focused": "",
            "visible": "",
            "default": ""
        }
    },

    "sway/window": {
        "format": "{title}",
        "max-length": 50,
        "tooltip": true,
        "rewrite": {
            "^$": "Let's get to work!",

            "^(.+) — Mozilla Firefox$": "󰈹 $1",
            "^Mozilla Firefox$": "󰈹 Firefox",

            "^(.+) - GNU Emacs.*$": " $1",
            "^(.+) - Emacs.*$": " $1",
            "^GNU Emacs.*$": " Emacs",
            "^Emacs.*$": " Emacs",

            "^.*melt@fedora: (.+)$": " $1",
            "^~$": " Kitty",
            "^kitty$": " Kitty",

            "^Visual Paradigm.*$": "󰒫 Visual Paradigm",

            "^WinBox.*$": "󱘖 WinBox",

            "^btop$": "󰆼 btop",

            "^(.+) - Obsidian.*$": "󱓧 $1",
            "^Obsidian.*$": "󱓧 Obsidian",

            "^Fedora Media Writer$": "󰛟 Media Writer",

            "^(.+)$": "$1"
        }
    },

    "mpd": {
        "format": "{stateIcon} {artist} - {title}",
        "format-disconnected": "Disconnected ",
        "format-stopped": "Stopped ",
        "tooltip": false,
        "state-icons": {
            "paused": "",
            "playing": ""
        }
    },

    "custom/firmware-updates": {
        "exec": "cat /tmp/available_firmware_updates 2>/dev/null",
        "interval": 60,
        "format": "{}",
        "on-click": "kitty sh -c '/home/melt/.local/bin/ud-firmware; echo; echo \"Press ENTER to exit...\"; read'",
        "tooltip": false
    },

    "custom/system-updates": {
        "exec": "cat /tmp/available_system_updates 2>/dev/null",
        "interval": 60,
        "format": "{}",
        "on-click": "kitty sh -c '/home/melt/.local/bin/ud-system; echo; echo \"Press ENTER to exit...\"; read'",
        "tooltip": false
    },

    "disk#home": {
        "format": "DISK {free}",
        "path": "/home",
        "tooltip": false
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "MEM {used:0.1f}G",
        "interval": 30,
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "TEMP {temperatureC}°C",
        "tooltip": false
    },

    "network": {
        "interval": 2,
        "format-wifi": "WIFI {essid}",
        "format-ethernet": "ETH {ipaddr}",
        "format-disconnected": "status",
        "tooltip": false
    },

    "bluetooth": {
        "format": "BT {status}",
        "format-connected": "BT {device_alias}",
        "on-click": "/home/melt/.local/bin/bluetooth_switch.sh",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "tooltip": false
    },

    "clock": {
        "format": "{:%a %d.%m %H:%M}",
        "tooltip": false
    },

    "tray": {
        "spacing": 10
    },

    "custom/power-profile": {
        "exec": "cat /tmp/power_profile_status 2>/dev/null",
        "interval": 5,
        "format": "{}",
        "tooltip": false,
        "on-click": "/home/melt/.local/bin/power_profile_switch.sh"
    },

    "battery": {
        "bat": "BAT0",
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}% ({time}) [{power:.1f}W]",
        "format-charging": "󱐋 BAT {capacity}% (+{power:.1f}W)",
        "format-plugged": " {capacity}%",
        "format-full": "󰁹 FULL",
        "format-icons": ["", "", "", "", ""],
        "interval": 5,
        "tooltip": false
    },
}