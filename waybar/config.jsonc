 {
    "layer": "top",
    "position": "top",
    "height": 28,
    "fixed-center": true,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "bluetooth",
        "network",
        "mpd"
    ],
    "modules-center": [
        "sway/window",
    ],
    "modules-right": [
        "custom/firmware",
        "custom/updates",
        "disk#home",
        "cpu",
        "memory",
        "temperature",
        "pulseaudio",
        "battery",
        "clock",
        "tray"
    ],

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>",
        "tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "tooltip": false,
        "format-icons": {
            "focused": "",
            "visible": "",
            "default": ""
        }
    },

"sway/window": {
        "format": "{title}",
        "max-length": 50,
        "tooltip": false,
        "rewrite": {
            "^$": "Let's get to work!",

            "^(.+) — Mozilla Firefox$": "󰈹 $1",
            "^Mozilla Firefox$": "󰈹 Firefox",

            "^(.+) - GNU Emacs.*$": " $1",
            "^(.+) - Emacs.*$": " $1",
            "^GNU Emacs.*$": " Emacs",
            "^Emacs.*$": " Emacs",

            "^.*melt@fedora: (.+)$": " $1",
            "^~$": " Kitty",
            "^kitty$": " Kitty",

            "^Visual Paradigm.*$": "󰒫 Visual Paradigm",

            "^WinBox.*$": "󱘖 WinBox",

            "^btop$": "󰆼 btop",

            "^(.+) - Obsidian.*$": "󱓧 $1",
            "^Obsidian.*$": "󱓧 Obsidian",

            "^Fedora Media Writer$": "󰛟 Media Writer",

            "^(.+)$": "$1"
        }
    },

    "mpd": {
        "format": "{stateIcon} {artist} - {title}",
        "format-disconnected": "Disconnected ",
        "format-stopped": "Stopped ",
        "tooltip": false,
        "state-icons": {
            "paused": "",
            "playing": ""
        }
    },

    "custom/firmware": {
        "exec": "~/.local/bin/check_firmware_updates.sh",
        "interval": 21600,
        "format": "{}",
        "tooltip": false,
        "on-click": "kitty --hold sh -c 'fwupdmgr get-updates'"
    },

    "custom/updates": {
    "exec": "~/.local/bin/check_updates.sh",
    "interval": 3600,
    "format": "{}",
    "tooltip": false
    },

    "disk#home": {
        "format": "HOME {free}",
        "path": "/home",
        "tooltip": false
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "MEM {used:0.1f}G",
        "interval": 30,
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "TEMP {temperatureC}°C",
        "tooltip": false
    },

    "network": {
        "interval": 2,
        "format-wifi": "WIFI {essid} 󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
        "format-ethernet": "ETH {ipaddr} 󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
        "format-disconnected": "status",
        "tooltip": false
    },

    "bluetooth": {
        "format": "BT {status}",
        "format-connected": "BT {device_alias}",
        "on-click": "",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "tooltip": false
    },

    "clock": {
        "format": "{:%a %d.%m %H:%M}",
        "tooltip": false
    },

    "tray": {
        "spacing": 10
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}% {icon}",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    }
}