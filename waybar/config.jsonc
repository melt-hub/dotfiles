{
    "layer": "top",
    "position": "top",
    "height": 28,
    "fixed-center": false,
    "spacing": 0,

    "modules-left": [
        "sway/workspaces",
        "custom/recording",
        "custom/firmware-updates",
        "custom/system-updates"
    ],

    "modules-center": [],

    "modules-right": [
        "network",
        "bluetooth",
        "custom/kernel",
        "custom/pkgs",
        "disk#home",
        "cpu",
        "custom/cpu-freq",
        "memory",
        "temperature",
        "custom/fan",
        "battery",
        "custom/power-usage",
        "power-profiles-daemon",
        "clock",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons": { "focused": "", "urgent": "", "default": "" },
        "tooltip": false
    },

    "custom/recording": {
        "exec": "[ -f /tmp/recording_active ] && echo \"󰑊 <b>REC</b>\"",
        "signal": 8,
        "format": "{}",
        "tooltip": false
    },

    "custom/firmware-updates": {
        "exec": "cat /tmp/available_firmware_updates 2>/dev/null",
        "interval": 60,
        "format": "{}",
        "on-click": "kitty sh -c '/home/melt/.local/bin/ud-firmware; echo; echo \"Press ENTER to exit...\"; read'",
        "tooltip": false
    },

    "custom/system-updates": {
        "exec": "cat /tmp/available_system_updates 2>/dev/null",
        "interval": 60,
        "format": "{}",
        "on-click": "kitty sh -c '/home/melt/.local/bin/ud-system; echo; echo \"Press ENTER to exit...\"; read'",
        "tooltip": false
    },

    "network": {
        "interval": 2,
        "format-wifi": "<b>WIFI</b> {essid} [D:{bandwidthDownBytes} U:{bandwidthUpBytes}]",
        "format-ethernet": "<b>ETH</b> {ipaddr} [D:{bandwidthDownBytes} U:{bandwidthUpBytes}]",
        "tooltip": false
    },

    "bluetooth": {
        "format": "<b>BT</b> {status}",
        "format-on": "<b>BT</b> on",
        "format-connected": "<b>BT</b> {device_alias}",
        "format-off": "",
        "format-disabled": "",
        "format-no-controller": "",
        "on-click": "/home/melt/dotfiles/scripts/connect.sh"
    },

    "disk#home": {
        "format": "<b>DSK</b> {free}",
        "path": "/home",
        "tooltip": false
    },

    "cpu": {
        "interval": 2,
        "format": "<b>CPU</b> {usage}% [L:{load}]",
        "tooltip": false
    },

    "custom/cpu-freq": {
        "exec": "cat /tmp/cpu_freq_status 2>/dev/null",
        "interval": 2,
        "format": "[{}]",
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "<b>MEM</b> {used:0.1f}G",
        "tooltip": false
    },

    "temperature": {
        "thermal-zone": 8,
        "format": "<b>TP</b> {temperatureC}°C",
        "tooltip": false
    },

    "custom/fan": {
        "exec": "cat /tmp/fan_speed_status 2>/dev/null",
        "interval": 5,
        "format": "[F:{}]",
        "tooltip": false
    },

    "custom/kernel": {
        "exec": "cat /tmp/kernel_version 2>/dev/null",
        "interval": 60,
        "format": "<b>KNL</b> {}",
        "tooltip": false
    },

    "custom/pkgs": {
        "exec": "cat /tmp/installed_pkgs 2>/dev/null",
        "interval": 60,
        "format": "[P:{}]",
        "tooltip": false
    },

    "battery": {
        "bat": "BAT0",
        "format": "<b>BAT</b> {capacity}% ({time})",
        "format-charging": "<b>BAT</b> {capacity}%",
        "format-plugged": "<b>AC</b> {capacity}%",
        "format-full": "<b>FULL</b>",
        "tooltip": false
    },

    "custom/power-usage": {
        "exec": "cat /tmp/power_usage_status 2>/dev/null",
        "interval": 2,
        "format": "{}",
        "tooltip": false
    },

    "power-profiles-daemon": {
        "format": "[<b>{icon}</b>]",
        "tooltip": false,
        "format-icons": {
            "default": "B",
            "performance": "P",
            "power-saver": "S"
        }
    },

    "clock": { "format": "<b>{:%a %d.%m %H:%M}</b>", "tooltip": false },
    "tray": { "spacing": 6 }
}