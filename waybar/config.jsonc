{
    "layer": "top",
    "position": "top",
    "height": 28,
    "fixed-center": false,
    "spacing": 0,

    "modules-left": [
        "sway/workspaces",
        "custom/recording",
        "custom/firmware-updates",
        "custom/system-updates"        
    ],

    "modules-center": [],

    "modules-right": [
        "network",
        "custom/net-ping",
        "bluetooth",
        "disk#home",
        "custom/disk-io",
        "cpu",
        "custom/cpu-freq",
        "custom/load",
        "custom/memory",
        "temperature",
        "custom/fan",
        "battery",
        "custom/power-usage",
        "power-profiles-daemon",
        "custom/kernel",
        "custom/pkgs",
        "clock",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons": { "focused": "", "urgent": "", "default": "" },
        "tooltip": false
    },

    "custom/recording": {
        "exec": "[ -f /tmp/recording_active ] && echo \"󰑊 <b>REC</b>\"",
        "interval": 1,
        "format": "{}",
        "tooltip": false
    },

    "custom/firmware-updates": {
        "exec": "cat /tmp/available_firmware_updates 2>/dev/null",
        "interval": 60,
        "format": "{}",
        "on-click": "kitty sh -c '/home/melt/.local/bin/ud-firmware; echo; echo \"Press ENTER to exit...\"; read'",
        "tooltip": false
    },

    "custom/system-updates": {
        "exec": "cat /tmp/available_system_updates 2>/dev/null",
        "interval": 60,
        "format": "{}",
        "on-click": "kitty sh -c '/home/melt/.local/bin/ud-system; echo; echo \"Press ENTER to exit...\"; read'",
        "tooltip": false
    },

    "network": {
        "interval": 2,
        "format-wifi": "<b>WIFI</b> {essid} [D:{bandwidthDownBytes} U:{bandwidthUpBytes}]",
        "format-ethernet": "<b>ETH</b> {ipaddr} [D:{bandwidthDownBytes} U:{bandwidthUpBytes}]",
        "tooltip": false
    },

    "custom/net-ping": {
        "exec": "~/.local/bin/check_ping.sh",
        "interval": 10,
        "format": "[P:{}ms]",
        "tooltip": false
    },

    "bluetooth": {
        "format": "<b>BT</b> {status}",
        "format-on": "<b>BT</b> on",
        "format-connected": "<b>BT</b> {device_alias}",
        "format-off": "",
        "format-disabled": "",
        "format-no-controller": "",
        "on-click": "/home/melt/dotfiles/scripts/connect.sh"
    },

    "disk#home": {
        "format": "<b>DSK</b> {free}",
        "path": "/home",
        "tooltip": false
    },

    "custom/disk-io": {
        "exec": "~/.local/bin/check_io_rate.sh",
        "interval": 2,
       "format": "[{}]",
       "tooltip": false
    },

    "cpu": { "format": "<b>CPU</b> {usage}%", "interval": 2 },

    "custom/cpu-freq": {
        "exec": "~/.local/bin/check_cpu_rate.sh",
        "interval": 2,
        "format": "[{}]",
        "tooltip": false
    },

    "custom/load": {
        "exec": "cat /proc/loadavg | awk '{print $1}'",
        "interval": 5,
        "format": "[L:{}]",
        "tooltip": false
    },

    "custom/memory": {
        "exec": "free -m | awk '/Mem:/ {mem=$3/1024} /Swap:/ {swap=$3/1024; if ($3 > 0) printf \"<b>MEM</b> %.1fG [S:%.1fG]\\n\", mem, swap; else printf \"<b>MEM</b> %.1fG\\n\", mem}'",
        "interval": 5,
        "format": "{}",
        "tooltip": false
    },

    "temperature": {
        "thermal-zone": 8,
        "format": "<b>TP</b> {temperatureC}°C",
        "tooltip": false
    },

    "custom/fan": {
        "exec": "~/.local/bin/check_fan_speed.sh",
        "interval": 5,
        "format": "[F:{}]",
        "tooltip": false
    },

    "battery": {
        "bat": "BAT0",
        "format": "<b>BAT</b> {capacity}% ({time})",
        "format-charging": "<b>BAT</b> {capacity}%",
        "format-plugged": "<b>AC</b> {capacity}%",
        "format-full": "<b>FULL</b>",
        "tooltip": false
    },

    "custom/power-usage": {
        "exec": "cat /tmp/power_usage_status 2>/dev/null",
        "interval": 2,
        "format": "{}",
        "tooltip": false
    },

    "power-profiles-daemon": {
        "format": "[<b>{icon}</b>]",
        "tooltip": false,
        "format-icons": {
            "default": "B",
            "performance": "P",
            "power-saver": "S"
        }
    },

    "custom/kernel": {
        "exec": "~/.local/bin/check_kernel_version.sh",
        "interval": 3600,
        "format": "<b>SYS</b> [K:{}]",
        "tooltip": false
    },

    "custom/pkgs": {
        "exec": "~/.local/bin/check_installed_packages.sh",
        "interval": 1800,
        "format": "[P:{}]",
        "tooltip": false
    },

    "clock": { "format": "<b>{:%a %d.%m %H:%M}</b>", "tooltip": false },
    "tray": { "spacing": 6 }
}