{
    "layer": "top",
    "position": "top",
    "height": 28,
    "fixed-center": false,
    "spacing": 0,

    "modules-left": [
        "sway/workspaces",
        "custom/recording",
        "custom/firmware-updates",
        "custom/system-updates"        
    ],

    "modules-center": [],

    "modules-right": [
        "network",
        "custom/net-ping",
        "bluetooth",
        "disk#home",
        "custom/disk-io",
        "cpu",
        "custom/cpu-freq",
        "custom/load",
        "memory",
        "temperature",
        "custom/fan",
        "pulseaudio",
        "backlight",        
        "battery",
        "custom/power-usage",
        "custom/power-profile",
        "custom/kernel",
        "custom/pkgs",
        "custom/entropy",
        "clock",
        "tray"
    ],

    /* --- MODULES LEFT --- */

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons": { "focused": "", "urgent": "", "default": "" }
    },

    "custom/recording": {
        "exec": "[ -f /tmp/recording_active ] && echo \"󰑊 <b>REC</b>\"",
        "interval": 1,
        "format": "{}"
    },

    "custom/firmware-updates": {
        "exec": "cat /tmp/available_firmware_updates 2>/dev/null",
        "interval": 60,
        "format": "<b>FW</b> {}"
    },

    "custom/system-updates": {
        "exec": "cat /tmp/available_system_updates 2>/dev/null",
        "interval": 60,
        "format": "<b>OS</b> {}"
    },

    /* --- MODULES RIGHT --- */

    "network": {
        "interval": 2,
        /* Using Bytes instead of Bits saves significant horizontal space */
        "format-wifi": "<b>WIFI</b> {essid} [D:{bandwidthDownBytes} U:{bandwidthUpBytes}]",
        "format-ethernet": "<b>ETH</b> {ipaddr} [D:{bandwidthDownBytes} U:{bandwidthUpBytes}]"
    },

    "custom/net-ping": {
        "exec": "~/.local/bin/check_ping.sh",
        "interval": 10,
        "format": "[P:{}]"
    },

    "bluetooth": {
        "format": "<b>BT</b> {status}",
        "format-connected": "<b>BT</b> {device_alias}",
        "on-click": "/home/melt/.local/bin/bluetooth_switch.sh"
    },

    "disk#home": { "format": "<b>DSK</b> {free}", "path": "/home" },

    "custom/disk-io": {
        "exec": "~/.local/bin/check_io_rate.sh",
        "interval": 2,
        "format": "[{}]"
    },

    "cpu": { "format": "<b>CPU</b> {usage}%", "interval": 2 },

    "custom/cpu-freq": {
        "exec": "~/.local/bin/check_cpu_rate.sh",
        "interval": 2,
        "format": "[{}]"
    },

    "custom/load": {
        "exec": "cat /proc/loadavg | awk '{print $1}'",
        "interval": 5,
        "format": "[L:{}]"
    },

    "memory": { "format": "<b>MEM</b> {used:0.1f}G [S:{swapUsed:0.1f}G]" },

    "temperature": { "format": "<b>TP</b> {temperatureC}°C" },

    "custom/fan": {
        "exec": "~/.local/bin/check_fan_speed.sh",
        "interval": 5,
        "format": "[F:{}]"
    },

    "pulseaudio": { "format": "<b>VL</b> {volume}%" },
    "backlight": { "format": "<b>BL</b> {percent}%" },

    "battery": {
        "bat": "BAT0",
        "format": "<b>BAT</b> {capacity}% ({time})",
        "format-charging": "<b>BAT</b> {capacity}%",
        "format-plugged": "<b>AC</b> {capacity}%",
        "format-full": "<b>FULL</b>"
    },

    "custom/power-usage": {
        "exec": "cat /tmp/power_usage_status 2>/dev/null",
        "interval": 2,
        "format": "{}"
    },

    "custom/power-profile": {
        "exec": "cat /tmp/power_profile_status 2>/dev/null",
        "interval": 5,
        "format": "[<b>{}</b>]",
        "on-click": "/home/melt/.local/bin/power_profile_switch.sh"
    },

    "custom/kernel": {
        "exec": "~/.local/bin/check_kernel_version.sh",
        "interval": 3600,
        "format": "<b>SYS</b> [K:{}]"
    },

    "custom/pkgs": {
        "exec": "~/.local/bin/check_installed_packages.sh",
        "interval": 1800,
        "format": "[P:{}]"
    },

    "custom/entropy": {
        "exec": "~/.local/bin/check_entropy.sh",
        "interval": 10,
        "format": "[E:{}]"
    },

    "clock": { "format": "<b>{:%a %d.%m %H:%M}</b>" },
    "tray": { "spacing": 6 }
}