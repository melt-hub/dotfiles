{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [
        "sway/window",
        "mpd"
    ],
    "modules-right": [
        "disk#home",
        "cpu",
        "memory",
        "temperature",
        "network",
        "bluetooth",
        "pulseaudio",
        "clock",
        "tray",
        "battery"
    ],
    "sway/workspaces": {
        "format": "{name}"
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 30
    },
    "disk#home": {
        "format": "HOME {free}",
        "path": "/home"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "MEM {used:0.1f}G",
        "interval": 30
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "TEMP {temperatureC}°C"
    },
    "network": {
        "format-wifi": "WIFI {essid}",
        "format-ethernet": "ETH {ipaddr}",
        "format-disconnected": "OFFLINE"
    },
    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "tooltip-format": "{num_connections} connected",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": ""
    },
    "pulseaudio": {
        "format": "VOL {volume}%"
    },
    "clock": {
        "format": "{:%a %d.%m %H:%M}",
        "tooltip": false
    },
    "tray": {
        "spacing": 10
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "mpd": {
        "format": "{stateIcon} {artist} - {title}",
        "format-disconnected": "Disconnected ",
        "format-stopped": "Stopped ",
        "state-icons": {
            "paused": "",
            "playing": ""
        }
    }
}