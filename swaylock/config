### ====================| MELT's SWAYLOCK CONFIG |====================

# (modus-vivendi, cyan accent)

# indicator dimensions
indicator-radius=80
indicator-thickness=7
ignore-empty-password

## ---------- ring ----------

# waiting
ring-color=ffffff
inside-color=000000
text-color=ffffff

# typing
key-hl-color=04A9E4
bs-hl-color=ff8059

# verifying (success)
ring-ver-color=04A9E4
inside-ver-color=1e1e1e
text-ver-color=ffffff

# wrong (error)
ring-wrong-color=ff8059
inside-wrong-color=000000
text-wrong-color=ffffff

# cleared (reset)
ring-clear-color=04A9E4
inside-clear-color=1e1e1e
text-clear-color=04A9E4

## ---------- layout & separators ----------

# hide keyboard layout (transparency trick)
layout-text-color=00000000
layout-bg-color=00000000
layout-border-color=00000000

# separator
line-color=00000000
separator-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-clear-color=00000000