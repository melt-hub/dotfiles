
### ===============| MELT's SWAY CONFIGURATION |===============

## ----- VARIABLES -----
#
# Mod1: <left Alt>
# Mod2: <Num Lock>
# Mod3: <Depends>
# Mod4: <Super> (either Win/Command)
# Mod5: <right Alt>

set $mod Mod4

## ----- HOME ROW DIRECTION KEYS -----
#
# vim like directions

set $left h
set $down j
set $up k
set $right l

## ----- PREFERRED TTY, APP LAUNCHER -----

set $term kitty

set $rofi_cmd rofi -terminal '$term'
set $windows $rofi_cmd -show window
set $menu $rofi_cmd -show combi -combi-modes drun
set $windows $rofi_cmd -show window

bindsym $mod+Tab exec $windows

# Rofi shows a combined list of the applications with desktop files and
# executables from PATH with $mod d. Pass the final command to swaymsg so that
# the resulting window can be opened on the original workspace that the command
# was run on. Rofi also shows a list of currently running applications with $mod
# TAB.

## ----- PERIPHERALS -----

# ----- output -----

output eDP-1 resolution 1920x1080 position 0,0
output HDMI-A-1 resolution 1920x1080@100Hz position 1920,0

# you can get the names of your outputs by running: swaymsg -t get_outputs

# ----- input -----

input * {
  xkb_layout us,it
  xkb_options grp:win_space_toggle
}

# you can get the names of your inputs by running: swaymsg -t get_inputs

## ----- IDLE -----

bindsym $mod+q exec swaylock -f -c 000000

exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000'

## ----- AUTOSTART -----

exec dunst

## ----- KEY BINDINGS -----

# ----- basics -----

# start a terminal
bindsym $mod+Return exec $term

# kill focused window
bindsym $mod+Shift+q kill

# start app launcher
bindsym $mod+d exec $menu

# reload the configuration file
bindsym $mod+Shift+c reload

# a. drag floating windows by holding down $mod and left mouse button.
# b. resize them with right mouse button + $mod.

# ! despite the name, also works for non-floating windows. Using inverse
# ! (instead of normal) uses left mouse button for resizing and right mouse
# ! button # for dragging.
floating_modifier $mod normal

# quit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m \
'are you sure you wanna quit sway?' -B 'yeah' 'swaymsg exit'

