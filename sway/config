
### ===============| MELT's LAYERED CONFIGURATION |===============

### ========== MAIN MODULE ==========

# The layered-include command will look for .conf files in:
# 1. /usr/share/sway/config.d (System defaults)
# 2. /etc/sway/config.d (Admin overrides)
# 3. ~/.config/sway/config.d (Your personal modules and masks)
#
# If a filename exists in multiple places, the later one wins (shadowing).

include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'

### ========== END MAIN MODULE ==========

